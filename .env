# MindLit AI Environment Configuration

# Application & Security
APP_NAME=MindLit AI
ENVIRONMENT=development
SECRET_KEY=dev_secret_change_in_production_key_mindlit_ai_9876543210
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# Production: postgresql+psycopg2://mindlit_user:mindlit_pass@localhost:5432/mindlit_db
# Local development fallback: sqlite:///./mindlit.db
DATABASE_URL=sqlite:///./mindlit.db

# Redis & Celery (Asynchronous background processing)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/uploads
# For S3 / MinIO:
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=mindlit-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Scientific Literature APIs (Europe PMC, PubMed, Crossref, OpenAlex)
EUROPEPMC_API_BASE=https://www.ebi.ac.uk/europepmc/webservices/rest
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
USER_EMAIL=researcher@mindlit.ai
CROSSREF_API_BASE=https://api.crossref.org/works
OPENALEX_API_BASE=https://api.openalex.org/works
OPENALEX_API_KEY=

# LLM & AI Configuration
# Providers: gemini, openai, local_heuristic
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Safety, Processing, & Limits
MAX_UPLOAD_SIZE_MB=35
MAX_PDF_PAGES=150
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=60
